extractedText=Topic \: JAVA ARRAYS\:\r\n-----------------------------\r\n\r\nJava array\u00A0is an object which contains elements of a similar data type.  \r\n\r\n  Syntax\:\r\n         <datatype> varaible_name[size];\r\n -> array size- 0 to n-1 \r\n\r\n   array initialization \:(creating the array)\r\n-------------------------------------------\r\n    <datatype> <var>[size]\=new <datatype>[size];\r\n\r\n   Example \:\r\n            int a[]\=new a[2];\r\n\r\n      //a[2] i.e a[0]  a[1] \r\n                 a[0]\=10; a[1]\=20;                \r\n\r\n________________________________________________\r\nTypes of arrays\:\r\n------------------\r\n1)1-D (one-dimensional)- its define only one indices\r\n                      ex\: int a[]\=new int a[5];\r\n\r\n2) 2-d(Two-dimensional)-its define only two indices\r\n                 ex\: int a[][]\=new int a[2][2];\r\n --------------------------------------------\r\n1-d\:\r\n\r\n1) Write a java program to demonstrate the 1-d arrays.\r\n------------------------------------------------\r\n\r\nclass Demoarray\r\n{\r\n   public static void main(String args[])\r\n   {\r\n\r\n      int a[]\=new int[5];\r\n       a[0]\=10;\r\n       a[1]\=20;\r\n       a[2]\=30;\r\n       a[3]\=40;\r\n       a[4]\=50;\r\n      for(int i\=0;i<5;i++)\r\n      {\r\n           System.out.println("The array elements are" +a[i]);\r\n      }\r\n}\r\n}\r\n_______________________________________________________________________\r\n\r\n2)write a java program to read and print the values using scanner statement using array .\r\n-------------------------------------------------------------------------------------\r\n\r\nimport java.util.Scanner;\r\nclass ReadPrintArray\r\n {\r\n    public static void main(String args[])\r\n    {\r\n         Scanner sc\=new Scanner(System.in);\r\n         System.out.println(" enter the array size");\r\n         int n\=sc.nextInt();\r\n         int a[]\=new int[n];  // array initilizations\r\n         System.out.println("To read the array elements are");\r\n         for(int i\=0;i<n;i++)\r\n         {\r\n            a[i]\=sc.nextInt();             // to read the array values\r\n         }\r\n\r\n        System.out.println("To print the array elements are");\r\n        \r\n         for(int i\=0;i<n;i++)       // to print the array values\r\n         {\r\n            System.out.println(a[i]);\r\n         }\r\n     }\r\n}\r\n________________________________________________________________________\r\n\r\nWrite a java program the sum of numbers using the array elements.\r\n\r\n  import java.util.Scanner;\r\n   class DemoSumArray\r\n   {\r\n      public static void main(String args[])\r\n      {\r\n          int sum\=0;\r\n          Scanner obj\=new Scanner(System.in);\r\n          System.out.println("Enter the array size");\r\n          int n\=obj.nextInt();\r\n          int a[]\=new int[n]; // n\=3\r\n          System.out.println("enter "+n+" array elements are ");\r\n         for(int i\=0;i<n;i++)\r\n         {\r\n             a[i]\=obj.nextInt(); //a[0]\=10  a[1]\=20  a[2]\=30\r\n             \r\n         }\r\n         for(int i\=0;i<n;i++)\r\n         {\r\n            sum\=sum+a[i];   // sum\=0+a[0]\=0+10 \=10   sum\=10+a[1] \= 10+20 \=30 sum\=30+30\=60\r\n             \r\n         }\r\n          System.out.println("The sum is  " +sum);\r\n    }\r\n}\r\n------------------------------------------------------------------\r\nWrite a java program to find the min and max value using array elements.\r\n------------------------------------------------------------------------\r\n  logic 1\: if(min[i]>max[i])          \r\n           s.o.p(min[i])\r\n           else\r\n           s.op (max[i])\r\n\r\nTypes of array\:\r\n-----------------\r\n\r\n1) Single Dimension arrays \: single dimension array to defines one indices .\r\n----------------------------\r\n   Syntax\: \r\n          datatype <var>\=new <datatype>[size];\r\n\r\n  Example\:\r\n              int a\=new a[5];\r\n \r\n\r\n2) Two-dimensional arrays\: Two-dimensional array to define two indices .\r\n-------------------------\r\n Syntax\: \r\n          datatype <var>\=new <datatype>[size][size];\r\n\r\n   Example\:\r\n              1) int a\=new a[5][5];\r\n\r\n              2) int[][] matrix \= {{10, 20, 30},{40, 50, 60},{70, 80, 90} };\r\n              3) int a[][]\=new int[2][2];\r\n___________________________________________________________________________________\r\n\r\n\r\nwrite a java program to demonstrate the two-dimensional array\r\n-----------------------------------------------------------\r\n\r\n class TwoDimarray\r\n{\r\n   public static void main(String args[])\r\n   {\r\n\r\n      int a[][]\=new int[2][2];\r\n       a[0][0]\=10;\r\n       a[0][1]\=20;\r\n       a[1][0]\=30;\r\n       a[1][1]\=40;\r\n\r\n      for(int i\=0;i<2;i++)\r\n      {\r\n          for(int j\=0;j<2;j++)\r\n          {\r\n          \r\n           System.out.println("The array elements are" +a[i][j]);\r\n         }\r\n      }\r\n   }\r\n}\r\n____________________________________________________________________\r\n2) write a java program to demonstrate the two-dimensional array using scanner class.\r\n\r\n   import java.util.*;\r\n   class TwoDimScanner\r\n   {\r\n      public static void main(String args[])\r\n      {\r\n            Scanner sc\=new Scanner(System.in);\r\n            System.out.print("Enter number of rows\: ");\r\n            int rows \= sc.nextInt();\r\n            System.out.print("Enter number of columns\: ");\r\n            int cols \= sc.nextInt();\r\n            int a[][] \= new int[rows][cols];  // int a[][]\=new int[2][2];\r\n            System.out.println("Enter the elements of the array\:");\r\n            \r\n            for(int i \= 0; i < rows; i++) \r\n            {\r\n            for (int j \= 0; j < cols; j++) \r\n            {\r\n                a[i][j] \= sc.nextInt();\r\n            }\r\n            }\r\n\r\n             System.out.println("The 2-dim array elements is\:");\r\n             for(int i \= 0; i < rows; i++) \r\n             {\r\n                 for(int j \= 0; j < cols; j++) \r\n                 {\r\n                   System.out.println(a[i][j] + " ");\r\n                 }\r\n                     \r\n             }\r\n     }\r\n}\r\n           \r\n_________________________________________________________________________________\r\n\r\nWrite a java program to matrix of addition using 2-d array.\r\n------------------------------------------------------------------\r\nimport java.util.Scanner;\r\n\r\nclass MatrixAdd\r\n{\r\n        public static void main(String args[]) \r\n       {\r\n        Scanner obj \= new Scanner(System.in);\r\n\r\n        System.out.println("Enter the row size\:");\r\n        int r \= obj.nextInt();\r\n        System.out.println("Enter the column size\:");\r\n        int c \= obj.nextInt();\r\n\r\n        int a[][] \= new int[r][c];\r\n        int b[][] \= new int[r][c];\r\n        int sum[][] \= new int[r][c];\r\n\r\n        System.out.println("Enter the elements of first matrix\:");\r\n         for (int i \= 0; i < r; i++) \r\n         {\r\n            for (int j \= 0; j < c; j++) \r\n           {\r\n                a[i][j] \= obj.nextInt();\r\n            }\r\n        }\r\n\r\n        System.out.println("Enter the elements of second matrix\:");\r\n        for (int i \= 0; i < r; i++) \r\n         {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                b[i][j] \= obj.nextInt();\r\n            }\r\n        }\r\n\r\n           // logic of sum matrix \r\n         for (int i \= 0; i < r; i++) \r\n         {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                sum[i][j] \= a[i][j] + b[i][j];\r\n            }\r\n        }\r\n\r\n  \r\n          System.out.println("The sum of two matrices is\:");\r\n            for (int i \= 0; i < r; i++) \r\n           {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                System.out.print(sum[i][j] + " ");\r\n            }\r\n            System.out.println();\r\n          }\r\n    }\r\n}\r\n\r\n\r\n\r\nWrite a java program  matrix subtraction using 2-d array.\r\n---------------------------------------------------------\r\n\r\n\r\n\r\nimport java.util.Scanner;\r\n\r\nclass MatrixSub\r\n{\r\n        public static void main(String args[]) \r\n       {\r\n        Scanner obj \= new Scanner(System.in);\r\n\r\n        System.out.println("Enter the row size\:");\r\n        int r \= obj.nextInt();\r\n        System.out.println("Enter the column size\:");\r\n        int c \= obj.nextInt();\r\n\r\n        int a[][] \= new int[r][c];\r\n        int b[][] \= new int[r][c];\r\n        int sum[][] \= new int[r][c];\r\n\r\n        System.out.println("Enter the elements of first matrix\:");\r\n        for (int i \= 0; i < r; i++) \r\n        {\r\n            for (int j \= 0; j < c; j++) \r\n             {\r\n                a[i][j] \= obj.nextInt();\r\n             }\r\n        }\r\n\r\n        System.out.println("Enter the elements of second matrix\:");\r\n         for (int i \= 0; i < r; i++) \r\n         {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                b[i][j] \= obj.nextInt();\r\n            }\r\n        }\r\n\r\n        \r\n         for (int i \= 0; i < r; i++) \r\n         {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                sum[i][j] \= a[i][j] - b[i][j];\r\n            }\r\n        }\r\n\r\n  \r\n        System.out.println("The sum of two matrices is\:");\r\n            for (int i \= 0; i < r; i++) \r\n           {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                System.out.print(sum[i][j] + " ");\r\n            }\r\n            System.out.println();\r\n          }\r\n    }\r\n}\r\n-------------------------------------------------------------------\r\nWrite a java program to transpose matrix using  2-d  array.\r\n------------------------------------------------------------\r\n\r\nimport java.util.Scanner;\r\n\r\nclass MatrixTranspose \r\n{\r\n        public static void main(String args[])\r\n       {\r\n        Scanner obj \= new Scanner(System.in);\r\n\r\n        System.out.println("Enter the row size\:");\r\n        int r \= obj.nextInt();\r\n        System.out.println("Enter the column size\:");\r\n        int c \= obj.nextInt();\r\n\r\n        int a[][] \= new int[r][c];\r\n\r\n        System.out.println("Enter the elements of the matrix\:");\r\n        for (int i \= 0; i < r; i++) \r\n        {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                a[i][j] \= obj.nextInt();\r\n            }\r\n        }\r\n\r\n        System.out.println("\\nTo Display the Matrix\:");\r\n        for (int i \= 0; i < r; i++) \r\n        {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                System.out.print(a[i][j] + " ");\r\n            }\r\n               System.out.println();\r\n        }\r\n\r\n        // Find transpose\r\n        int trans[][] \= new int[c][r];  // int[2][2]\r\n        for (int i \= 0; i < r; i++) \r\n         {\r\n            for (int j \= 0; j < c; j++) \r\n            {\r\n                trans[j][i] \= a[i][j];  // trans[0][0]\=a[0][0]\r\n            }\r\n        }\r\n\r\n      \r\n        System.out.println("\\nTranspose of the Matrix\:");\r\n        for (int i \= 0; i < c; i++) \r\n        {\r\n            for (int j \= 0; j < r; j++) \r\n           {\r\n                System.out.print(trans[i][j] + " ");\r\n            }\r\n            System.out.println();\r\n        }\r\n\r\n       \r\n    }\r\n}\r\n          \r\n      \r\n
